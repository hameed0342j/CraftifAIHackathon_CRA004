# systemd unit for the Jetson.
# sudo cp deploy/leaklatch-pipegen.service /etc/systemd/system/ && sudo systemctl enable --now leaklatch-pipegen
[Unit]
Description=LeakLatch PipeGen edge vision
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
User=leaklatch
WorkingDirectory=/opt/leaklatch
ExecStart=/opt/leaklatch/.venv/bin/python -m pipegen --config configs/site.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
